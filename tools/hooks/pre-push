#!/usr/bin/env sh
# ─────────────────────────────────────────────────────────────────────────────
# RedPash pre-push hook — hard-enforces "Case-first by default" (root CLAUDE.md).
#
# Blocks a push when a NON-TRIVIAL commit made since the discipline install lacks
# a Case reference (runs tools/case-coverage-audit/audit.js).
#
# SCOPED TO case-coverage ONLY — it does NOT run the full ci-audit ratchet, so
# unrelated audit drift can never wedge your pushes. (The full ratchet is ops's
# job at push time; this gate is just the Case rule.)
#
# Bypass (git's design — use sparingly): git push --no-verify
# Install: sh tools/hooks/install.sh
# ─────────────────────────────────────────────────────────────────────────────

REPO="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$REPO" || exit 0

# Resolve node (dev shells use nvm). If node is genuinely absent, WARN + allow —
# a tooling blip must never block a push (fail-open on infra; mirrors check.sh).
if ! command -v node >/dev/null 2>&1; then
  export NVM_DIR="$HOME/.nvm"
  [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh" >/dev/null 2>&1
fi
if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node not found — skipping the case-coverage check (NOT blocking)." >&2
  exit 0
fi

out="$(node tools/case-coverage-audit/audit.js 2>&1)"
rc=$?

if [ "$rc" -ne 0 ]; then
  echo "──────────────────────────────────────────────────────────────────────" >&2
  echo "  push BLOCKED — Case-first by default (CLAUDE.md)" >&2
  echo "──────────────────────────────────────────────────────────────────────" >&2
  printf '%s\n' "$out" >&2
  echo "" >&2
  echo "  Fix: open a Case (mcp__redpash-slack__case_create) and put its CAS_… in" >&2
  echo "       the commit message — amend if the commit isn't pushed yet." >&2
  echo "  Bypass (sparingly): git push --no-verify" >&2
  echo "──────────────────────────────────────────────────────────────────────" >&2
  exit 1
fi

# Docs-currency gate FEED (best-effort, NEVER blocks): record which pushed commits
# reconciled which Case's docs so the cases `→ done` gate can read it (touched docs/
# OR a `Docs:` ack). The gate is the hard enforcement — a DB-down / missing-cargo /
# build blip here must not wedge a push. See backend/.../bin/commit_ingest.rs.
if command -v cargo >/dev/null 2>&1; then
  # The Cargo workspace is in backend/, not the repo root — run cargo there (a subshell
  # keeps the hook's CWD at $REPO for everything else). git/.env still resolve correctly.
  ( cd "$REPO/backend" && cargo run -q -p api --bin redpash-commit-ingest ) >/dev/null 2>&1 \
    || echo "pre-push: commit-ingest skipped (DB/build unavailable) — not blocking." >&2
fi

exit 0
