# ── Audit tooling — generated reports ─────────────────────────────
# tools/*-audit/ emit standalone HTML reports + an audit.json payload,
# regenerated by every `node audit.js` run. Track the scripts + the
# ci-audit baseline; never the generated outputs.
/tools/**/*.html
/tools/**/audit.json
/tools/ui-snapshot-audit/snapshots/
