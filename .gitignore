# ── Rust ──────────────────────────────────────────────────────────
# 12 GB of build artefacts at last check — never commit.
/backend/target/
# sqlx offline-query cache; not needed for app builds (CI can regenerate).
/backend/.sqlx/

# ── Secrets ───────────────────────────────────────────────────────
# Real env file with DATABASE_URL + OAuth credentials. .env.example is
# tracked as the template. /backend/.env is a symlink (env-swap.sh
# flips it between .env.main / .env.prerelease per branch); both
# variants carry secrets and stay untracked.
/backend/.env
/backend/.env.main
/backend/.env.prerelease
.env
.env.local

# ── User data — on-disk file blob store ──────────────────────────
# REDPASH_DATA_DIR defaults to ./backend/data; holds uploaded CSV
# bytes (files/<rid>.bin). 7.6 GB and growing per dev session.
/backend/data/
/data/

# ── Node / JS (if any deps land later) ───────────────────────────
**/node_modules/
**/dist/
**/.cache/

# ── Logs / runtime ────────────────────────────────────────────────
*.log
*.pid
/tmp/

# ── OS cruft ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDEs ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.iml
*.swp
*.swo

# ── Audit tooling — generated reports ─────────────────────────────
# tools/*-audit/audit.js emit standalone HTML reports (audit.html /
# report.html — embed the full DATA JSON, 0.2–1.8 MB each).
# tools/*-audit/audit.json is the payload `redpash-audit-ingest`
# reads to persist audit.run + audit.finding rows — regenerated by
# every `node audit.js` run, history lives in Postgres.
# Regenerate on demand; never track any of these.
/tools/**/*.html
/tools/**/audit.json

# ── WASM build output ─────────────────────────────────────────────
# frontend/wasm/ holds wasm-bindgen output for the `data` crate
# (~11 MB raw / ~3.3 MB gzipped). Regenerated by `sh tools/build-wasm.sh`
# after any change to backend/crates/data/src/wasm.rs. Source of truth
# is the Rust crate; never track the compiled binary.
/frontend/wasm/data_bg.wasm
/frontend/wasm/data.js
/frontend/wasm/*.d.ts

# tools/wasm-bench/corpus/ holds generated CSV bench fixtures
# Regenerated by python3 tools/wasm-bench/generate.py
/tools/wasm-bench/corpus/
