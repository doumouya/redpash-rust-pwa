{
  "_meta": {
    "name": "redpash-latte",
    "version": 1,
    "author": "Gus + Torv",
    "note": "Light-mode sibling of redpash-mocha. Palette = designer.js THEMES.latte (Catppuccin Latte) padded to 8; remaining tokens = frontend/styles/tokens.css html[data-theme='light']. Same runtime ECharts shape — pass to echarts.registerTheme('redpash-latte', JSON) at boot, then echarts.init(el, 'redpash-latte')."
  },

  "color": [
    "#1e66f5",
    "#8839ef",
    "#179299",
    "#fe640b",
    "#d20f39",
    "#df8e1d",
    "#40a02b",
    "#04a5e5"
  ],

  "backgroundColor": "transparent",

  "textStyle": {
    "color": "#4c4f69",
    "fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
  },

  "title": {
    "textStyle":    { "color": "#4c4f69", "fontWeight": 600 },
    "subtextStyle": { "color": "#5c5f77" }
  },

  "legend": {
    "textStyle": { "color": "#5c5f77" },
    "icon": "roundRect",
    "itemWidth": 14,
    "itemHeight": 9
  },

  "tooltip": {
    "backgroundColor": "#ffffff",
    "borderColor":     "#ccd0da",
    "borderWidth":     1,
    "textStyle":       { "color": "#4c4f69" },
    "axisPointer": {
      "type": "shadow",
      "lineStyle":   { "color": "#8c8fa1", "width": 1 },
      "shadowStyle": { "color": "rgba(30, 102, 245, 0.08)" }
    }
  },

  "categoryAxis": {
    "axisLine":  { "show": false, "lineStyle": { "color": "#ccd0da" } },
    "axisTick":  { "show": false, "lineStyle": { "color": "#ccd0da" } },
    "axisLabel": { "color": "#4c4f69", "fontSize": 12 },
    "splitLine": { "show": false, "lineStyle": { "color": ["#ccd0da"] } },
    "splitArea": { "show": false, "areaStyle": { "color": ["rgba(76,79,105,0.02)"] } }
  },
  "valueAxis": {
    "axisLine":  { "show": false, "lineStyle": { "color": "#ccd0da" } },
    "axisTick":  { "show": false, "lineStyle": { "color": "#ccd0da" } },
    "axisLabel": { "color": "#8c8fa1", "fontSize": 10 },
    "splitLine": { "show": true,  "lineStyle": { "color": ["#ccd0da"], "type": "dashed", "opacity": 0.6 } },
    "splitArea": { "show": false, "areaStyle": { "color": ["rgba(76,79,105,0.02)"] } }
  },
  "logAxis": {
    "axisLine":  { "show": false, "lineStyle": { "color": "#ccd0da" } },
    "axisTick":  { "show": false, "lineStyle": { "color": "#ccd0da" } },
    "axisLabel": { "color": "#8c8fa1", "fontSize": 10 },
    "splitLine": { "show": true,  "lineStyle": { "color": ["#ccd0da"], "type": "dashed", "opacity": 0.6 } }
  },
  "timeAxis": {
    "axisLine":  { "show": false, "lineStyle": { "color": "#ccd0da" } },
    "axisTick":  { "show": false, "lineStyle": { "color": "#ccd0da" } },
    "axisLabel": { "color": "#8c8fa1", "fontSize": 10 },
    "splitLine": { "show": true,  "lineStyle": { "color": ["#ccd0da"], "type": "dashed", "opacity": 0.6 } }
  },

  "line": {
    "itemStyle":   { "borderWidth": 1 },
    "lineStyle":   { "width": 2 },
    "symbolSize":  6,
    "symbol":      "circle",
    "smooth":      false
  },
  "bar": {
    "itemStyle":  { "borderRadius": [0, 4, 4, 0] }
  },
  "pie": {
    "itemStyle":  { "borderColor": "#ffffff", "borderWidth": 1 }
  },
  "scatter": {
    "itemStyle":  { "borderWidth": 0 }
  },
  "graph": {
    "itemStyle":  { "borderWidth": 0 },
    "lineStyle":  { "width": 1, "color": "#8c8fa1" },
    "color":      ["#1e66f5", "#8839ef", "#179299", "#fe640b", "#d20f39", "#df8e1d"],
    "label":      { "color": "#4c4f69" }
  },
  "candlestick": {
    "itemStyle": {
      "color":         "#40a02b",
      "color0":        "#d20f39",
      "borderColor":   "#40a02b",
      "borderColor0":  "#d20f39",
      "borderWidth":   1
    }
  },
  "boxplot": {
    "itemStyle": { "color": "#1e66f5", "borderColor": "#4c4f69", "borderWidth": 1 }
  },
  "gauge": {
    "axisLine":  { "lineStyle": { "color": [[0.25, "#40a02b"], [0.75, "#df8e1d"], [1, "#d20f39"]] } },
    "title":     { "color": "#4c4f69" },
    "detail":    { "color": "#4c4f69" }
  },
  "radar": {
    "axisLine":  { "lineStyle": { "color": "#ccd0da" } },
    "axisName":  { "color": "#5c5f77" },
    "splitLine": { "lineStyle": { "color": "#ccd0da" } },
    "splitArea": { "areaStyle": { "color": ["rgba(30, 102, 245, 0.03)", "rgba(30, 102, 245, 0.08)"] } }
  },

  "visualMap": {
    "color":     ["#d20f39", "#fe640b", "#df8e1d", "#40a02b", "#1e66f5"],
    "textStyle": { "color": "#5c5f77" }
  },

  "dataZoom": {
    "backgroundColor":   "rgba(0,0,0,0)",
    "dataBackgroundColor": "rgba(76,79,105,0.08)",
    "fillerColor":       "rgba(30, 102, 245, 0.12)",
    "handleColor":       "#1e66f5",
    "handleSize":        "100%",
    "textStyle":         { "color": "#8c8fa1" }
  },

  "timeline": {
    "lineStyle":          { "color": "#ccd0da", "width": 1 },
    "itemStyle":          { "color": "#1e66f5", "borderWidth": 1 },
    "controlStyle":       { "color": "#4c4f69", "borderColor": "#ccd0da" },
    "checkpointStyle":    { "color": "#d20f39", "borderColor": "#ffffff" },
    "label":              { "color": "#5c5f77" },
    "emphasis": {
      "itemStyle":    { "color": "#8839ef" },
      "controlStyle": { "color": "#4c4f69", "borderColor": "#4c4f69" },
      "label":        { "color": "#4c4f69" }
    }
  },

  "toolbox": {
    "iconStyle":  { "borderColor": "#8c8fa1" },
    "emphasis":   { "iconStyle": { "borderColor": "#4c4f69" } }
  },

  "markPoint": {
    "label":    { "color": "#4c4f69" },
    "emphasis": { "label": { "color": "#4c4f69" } }
  }
}
