{
  "_meta": {
    "name": "redpash-mocha",
    "version": 1,
    "author": "Gus + Torv",
    "note": "Sample for the global ECharts theme discussion (Internal-Slack 2026-05-24). Palette mirrors designer.js:31-41 'mocha' entry; remaining tokens come from frontend/styles/tokens.css [data-theme=dark]. Runtime ECharts theme shape — pass to echarts.registerTheme('redpash-mocha', JSON) at boot, then echarts.init(el, 'redpash-mocha')."
  },

  "color": [
    "#89b4fa",
    "#cba6f7",
    "#94e2d5",
    "#fab387",
    "#f38ba8",
    "#f9e2af",
    "#a6e3a1",
    "#74c7ec"
  ],

  "backgroundColor": "transparent",

  "textStyle": {
    "color": "#cdd6f4",
    "fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
  },

  "title": {
    "textStyle":    { "color": "#cdd6f4", "fontWeight": 600 },
    "subtextStyle": { "color": "#a6adc8" }
  },

  "legend": {
    "textStyle": { "color": "#a6adc8" },
    "icon": "roundRect",
    "itemWidth": 14,
    "itemHeight": 9
  },

  "tooltip": {
    "backgroundColor": "#1e1e2e",
    "borderColor":     "#313244",
    "borderWidth":     1,
    "textStyle":       { "color": "#cdd6f4" },
    "axisPointer": {
      "type": "shadow",
      "lineStyle":   { "color": "#6c7086", "width": 1 },
      "shadowStyle": { "color": "rgba(137, 180, 250, 0.10)" }
    }
  },

  "categoryAxis": {
    "axisLine":  { "show": false, "lineStyle": { "color": "#313244" } },
    "axisTick":  { "show": false, "lineStyle": { "color": "#313244" } },
    "axisLabel": { "color": "#cdd6f4", "fontSize": 12 },
    "splitLine": { "show": false, "lineStyle": { "color": ["#313244"] } },
    "splitArea": { "show": false, "areaStyle": { "color": ["rgba(255,255,255,0.02)"] } }
  },
  "valueAxis": {
    "axisLine":  { "show": false, "lineStyle": { "color": "#313244" } },
    "axisTick":  { "show": false, "lineStyle": { "color": "#313244" } },
    "axisLabel": { "color": "#6c7086", "fontSize": 10 },
    "splitLine": { "show": true,  "lineStyle": { "color": ["#313244"], "type": "dashed", "opacity": 0.45 } },
    "splitArea": { "show": false, "areaStyle": { "color": ["rgba(255,255,255,0.02)"] } }
  },
  "logAxis": {
    "axisLine":  { "show": false, "lineStyle": { "color": "#313244" } },
    "axisTick":  { "show": false, "lineStyle": { "color": "#313244" } },
    "axisLabel": { "color": "#6c7086", "fontSize": 10 },
    "splitLine": { "show": true,  "lineStyle": { "color": ["#313244"], "type": "dashed", "opacity": 0.45 } }
  },
  "timeAxis": {
    "axisLine":  { "show": false, "lineStyle": { "color": "#313244" } },
    "axisTick":  { "show": false, "lineStyle": { "color": "#313244" } },
    "axisLabel": { "color": "#6c7086", "fontSize": 10 },
    "splitLine": { "show": true,  "lineStyle": { "color": ["#313244"], "type": "dashed", "opacity": 0.45 } }
  },

  "line": {
    "itemStyle":   { "borderWidth": 1 },
    "lineStyle":   { "width": 2 },
    "symbolSize":  6,
    "symbol":      "circle",
    "smooth":      false
  },
  "bar": {
    "itemStyle":  { "borderRadius": [0, 4, 4, 0] }
  },
  "pie": {
    "itemStyle":  { "borderColor": "#181825", "borderWidth": 1 }
  },
  "scatter": {
    "itemStyle":  { "borderWidth": 0 }
  },
  "graph": {
    "itemStyle":  { "borderWidth": 0 },
    "lineStyle":  { "width": 1, "color": "#6c7086" },
    "color":      ["#89b4fa", "#cba6f7", "#94e2d5", "#fab387", "#f38ba8", "#f9e2af"],
    "label":      { "color": "#cdd6f4" }
  },
  "candlestick": {
    "itemStyle": {
      "color":         "#a6e3a1",
      "color0":        "#f38ba8",
      "borderColor":   "#a6e3a1",
      "borderColor0":  "#f38ba8",
      "borderWidth":   1
    }
  },
  "boxplot": {
    "itemStyle": { "color": "#89b4fa", "borderColor": "#cdd6f4", "borderWidth": 1 }
  },
  "gauge": {
    "axisLine":  { "lineStyle": { "color": [[0.25, "#a6e3a1"], [0.75, "#f9e2af"], [1, "#f38ba8"]] } },
    "title":     { "color": "#cdd6f4" },
    "detail":    { "color": "#cdd6f4" }
  },
  "radar": {
    "axisLine":  { "lineStyle": { "color": "#313244" } },
    "axisName":  { "color": "#a6adc8" },
    "splitLine": { "lineStyle": { "color": "#313244" } },
    "splitArea": { "areaStyle": { "color": ["rgba(137, 180, 250, 0.04)", "rgba(137, 180, 250, 0.10)"] } }
  },

  "visualMap": {
    "color":     ["#f38ba8", "#fab387", "#f9e2af", "#a6e3a1", "#89b4fa"],
    "textStyle": { "color": "#a6adc8" }
  },

  "dataZoom": {
    "backgroundColor":   "rgba(0,0,0,0)",
    "dataBackgroundColor": "rgba(255,255,255,0.10)",
    "fillerColor":       "rgba(137, 180, 250, 0.18)",
    "handleColor":       "#89b4fa",
    "handleSize":        "100%",
    "textStyle":         { "color": "#6c7086" }
  },

  "timeline": {
    "lineStyle":          { "color": "#313244", "width": 1 },
    "itemStyle":          { "color": "#89b4fa", "borderWidth": 1 },
    "controlStyle":       { "color": "#cdd6f4", "borderColor": "#313244" },
    "checkpointStyle":    { "color": "#f38ba8", "borderColor": "#181825" },
    "label":              { "color": "#a6adc8" },
    "emphasis": {
      "itemStyle":    { "color": "#cba6f7" },
      "controlStyle": { "color": "#cdd6f4", "borderColor": "#cdd6f4" },
      "label":        { "color": "#cdd6f4" }
    }
  },

  "toolbox": {
    "iconStyle":  { "borderColor": "#6c7086" },
    "emphasis":   { "iconStyle": { "borderColor": "#cdd6f4" } }
  },

  "markPoint": {
    "label":    { "color": "#cdd6f4" },
    "emphasis": { "label": { "color": "#cdd6f4" } }
  }
}
