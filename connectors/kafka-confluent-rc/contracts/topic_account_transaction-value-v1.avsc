{
  "type": "record",
  "name": "AccountTransaction",
  "namespace": "example",
  "fields": [
    {
      "name": "transactionId",
      "type": "string",
      "doc": "Unique identifier for the transaction"
    },
    {
      "name": "accountId",
      "type": "string",
      "doc": "Foreign key referencing example.Account"
    },
    {
      "name": "transactionTimestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Epoch time in milliseconds"
    },
    {
      "name": "transactionType",
      "type": {
        "type": "enum",
        "name": "TxnType",
        "symbols": [
          "DEPOSIT",
          "WITHDRAWAL",
          "TRANSFER_IN",
          "TRANSFER_OUT",
          "FEE"
        ]
      }
    },
    {
      "name": "amount",
      "type": "double",
      "doc": "Transaction amount"
    },
    {
      "name": "currencyCode",
      "type": "string",
      "default": "USD"
    },
    {
      "name": "status",
      "type": [
        "null",
        "string"
      ],
      "doc": "PENDING, COMPLETED, or FAILED",
      "default": null
    }
  ]
}
