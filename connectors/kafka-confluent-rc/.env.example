# connectors/kafka-confluent-rc/.env — copy to .env and fill values. .env is gitignored.
# Find these in Confluent Cloud UI:
#   - Cluster page → "API keys" section (Kafka credentials)
#   - Schema Registry page → "API keys" section (registry credentials)
#   - Cluster settings → "Cluster details" → bootstrap server
#   - Schema Registry settings → "Endpoint"

# Schema Registry endpoint (HTTPS URL ending in confluent.cloud)
SCHEMA_REGISTRY_URL=https://psrc-xxxxx.region.aws.confluent.cloud

# Schema Registry credentials (DIFFERENT from Kafka cluster credentials)
SCHEMA_REGISTRY_KEY=
SCHEMA_REGISTRY_SECRET=

# Kafka cluster bootstrap (used for end-to-end decode in phase 5)
KAFKA_BOOTSTRAP=pkc-xxxxx.region.aws.confluent.cloud:9092

# Kafka cluster credentials
KAFKA_KEY=
KAFKA_SECRET=

# Topic to consume one message from (phase 5 end-to-end decode)
KAFKA_TOPIC=

# Optional — restrict phase 1/2 to specific subjects (comma-separated).
# Leave empty to discover all subjects.
SUBJECTS=
