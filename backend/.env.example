# Copy to `.env` and adjust. Loaded by `redpash-api` at startup via
# `dotenvy::dotenv()`. Variables consumed:
#
#   DATABASE_URL                  Postgres connection string. Required from phase 2.
#   REDPASH_BIND                  host:port for the HTTP server. Default 0.0.0.0:8080.
#   REDPASH_DATA_DIR              Root for on-disk file storage. Default ./data.
#   RUST_LOG                      tracing-subscriber filter. Default info,sqlx=warn,hyper=warn.
#
#   GOOGLE_OAUTH_CLIENT_ID        Google OAuth client ID — leave blank to stay
#   GOOGLE_OAUTH_CLIENT_SECRET    in dev_user mode. All three are required to
#   GOOGLE_OAUTH_REDIRECT_URI     enable the /api/auth/google/* routes.
#
#   REDPASH_DEV_LOGIN             Dev only. "1"/"true" enables POST
#                                 /api/auth/dev-login (the Home header's
#                                 "log in as user" switcher) — mints a
#                                 session for any user with no credentials.
#                                 Off by default. Never set in production.
#
# Setting up Google OAuth (Phase 4):
#   1. console.cloud.google.com → APIs & Services → Credentials →
#      "Create OAuth client ID".
#   2. Application type: Web application.
#   3. Authorized redirect URI: http://localhost:8080/api/auth/google/callback
#   4. Paste the client ID + client secret here. RedPash picks them up on next boot.

DATABASE_URL=postgres://mansa:mansa@localhost:5432/redpash_app_dev
REDPASH_BIND=0.0.0.0:8080
REDPASH_DATA_DIR=./data
RUST_LOG=info,sqlx=warn,hyper=warn

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
